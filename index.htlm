<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#07070f" id="tmc">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="TradeBook">
<title>TradeBook</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<style>
:root{--bg:#07070f;--surf:#0d0d1a;--surf2:#13131f;--bord:#1a1a2e;--green:#00e676;--gd:rgba(0,230,118,.12);--gd2:rgba(0,230,118,.28);--red:#ff3d5a;--rd:rgba(255,61,90,.12);--blue:#5c6fff;--text:#d8d8e8;--dim:#50508a;--dim2:#2a2a40;--font:'Syne',sans-serif;--mono:'Space Mono',monospace;--r:12px;--nav:58px;--hdr:52px}
[data-theme=light]{--bg:#f2f2f7;--surf:#fff;--surf2:#e8e8f0;--bord:#dadadf;--text:#111;--dim:#888;--dim2:#ccc}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden;background:#000}
body{font-family:var(--font);color:var(--text)}
button,input{font-family:var(--font);border:none;outline:none;cursor:pointer;background:none;color:inherit}
#app{width:100%;max-width:430px;margin:0 auto;height:100dvh;display:flex;flex-direction:column;background:var(--bg);position:relative;overflow:hidden;transition:background .3s}
.hdr{height:var(--hdr);padding:0 16px;flex-shrink:0;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--bord);background:var(--bg);z-index:10}
.logo{font-size:18px;font-weight:800;letter-spacing:-.5px;color:var(--text)}.logo em{color:var(--green);font-style:normal}
.hdr-r{display:flex;align-items:center;gap:8px}
.sdot{width:8px;height:8px;border-radius:50%;background:var(--dim2);flex-shrink:0}
.sdot.ok{background:var(--green)}.sdot.err{background:var(--red)}.sdot.syncing{background:#f0a500;animation:blink .7s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}
.slbl{font-family:var(--mono);font-size:9px;color:var(--dim);cursor:pointer}
#main{flex:1;min-height:0;overflow:hidden;position:relative}
.page{display:none;flex-direction:column;height:100%;overflow:hidden}.page.active{display:flex}
.scroll{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:10px 13px 20px}
.scroll::-webkit-scrollbar{display:none}
.lscroll{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:0 13px}
.lscroll::-webkit-scrollbar{display:none}
.nav{height:var(--nav);flex-shrink:0;display:flex;background:var(--surf);border-top:1px solid var(--bord);padding-bottom:env(safe-area-inset-bottom,0px);z-index:10}
.tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:8px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:var(--dim);transition:color .2s;padding:6px 0}
.tab.on{color:var(--green)}.tic{font-size:19px;line-height:1}
.strip{display:flex;gap:5px;padding:9px 13px;overflow-x:auto;flex-shrink:0;scrollbar-width:none;border-bottom:1px solid var(--bord)}
.strip::-webkit-scrollbar{display:none}
.chip{padding:5px 13px;border-radius:20px;font-size:10px;font-weight:700;flex-shrink:0;cursor:pointer;background:var(--surf2);color:var(--dim);border:1px solid var(--bord);font-family:var(--mono)}
.chip.on{background:var(--gd);color:var(--green);border-color:var(--gd2)}
.pnl-hero{padding:14px 0 6px}.pnl-lbl{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--dim);margin-bottom:4px}
.pnl-val{font-family:var(--mono);font-size:26px;font-weight:700;line-height:1}
.pnl-val.pos{color:var(--green)}.pnl-val.neg{color:var(--red)}.pnl-val.zero{color:var(--dim)}
.eq-wrap{height:155px;margin:8px -2px 10px}
.sgrid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:8px}
.sc{background:var(--surf);border:1px solid var(--bord);border-radius:var(--r);padding:11px 12px}
.sl{font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--dim);margin-bottom:5px}
.sv{font-family:var(--mono);font-size:17px;font-weight:700;line-height:1}
.sv.pos{color:var(--green)}.sv.neg{color:var(--red)}.sv.neu{color:var(--text)}
.ss{font-size:8px;color:var(--dim);font-family:var(--mono);margin-top:3px}
.bal{background:var(--surf);border:1px solid var(--bord);border-radius:var(--r);padding:11px 13px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center}
.bal-g{display:flex;flex-direction:column;gap:3px}
.bal-lbl{font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--dim)}
.bal-val{font-family:var(--mono);font-size:13px;font-weight:700;color:var(--text)}
.top-card{background:var(--surf);border:1px solid var(--bord);border-radius:var(--r);padding:12px 13px;margin-bottom:4px}
.top-hdr{display:flex;justify-content:space-between;margin-bottom:4px}
.top-ttl{font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--dim)}
.div{height:1px;background:var(--bord);margin-bottom:10px}
.top-row{display:flex;align-items:center;gap:8px;margin-bottom:9px}.top-row:last-child{margin-bottom:0}
.top-sym{font-family:var(--mono);font-size:10px;font-weight:700;color:var(--text);width:80px;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bar-wrap{flex:1;height:5px;background:var(--surf2);border-radius:3px;overflow:hidden}
.bar-fill{height:100%;border-radius:3px}
.top-pnl{font-family:var(--mono);font-size:11px;font-weight:700;width:76px;text-align:right;flex-shrink:0;white-space:nowrap}
.top-pnl.pos{color:var(--green)}.top-pnl.neg{color:var(--red)}
.tr{display:flex;align-items:center;justify-content:space-between;padding:13px 0;border-bottom:1px solid var(--bord);cursor:pointer}
.tr:last-child{border-bottom:none}.tr:active{opacity:.55}
.tr-l{display:flex;flex-direction:column;gap:5px}
.tr-top{display:flex;align-items:center;gap:7px}
.tr-sym{font-size:14px;font-weight:800;color:var(--text)}
.tr-time{font-size:10px;color:var(--dim);font-family:var(--mono)}
.tr-r{display:flex;flex-direction:column;align-items:flex-end;gap:4px}
.tr-pnl{font-family:var(--mono);font-size:14px;font-weight:700}
.tr-pnl.pos{color:var(--green)}.tr-pnl.neg{color:var(--red)}.tr-pnl.zero{color:var(--dim)}
.tr-sz{font-size:10px;color:var(--dim);font-family:var(--mono)}
.badge{font-size:8px;font-weight:700;padding:2px 7px;border-radius:5px;text-transform:uppercase;flex-shrink:0}
.bl{background:rgba(0,230,118,.12);color:var(--green)}.bs{background:rgba(255,61,90,.12);color:var(--red)}.bb{background:rgba(92,111,255,.12);color:var(--blue)}
.card{background:var(--surf);border:1px solid var(--bord);border-radius:var(--r);padding:11px 12px;margin-bottom:8px}
.cttl{font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--dim)}
.cnav{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.mnav{background:var(--surf2);border:1px solid var(--bord);border-radius:6px;color:var(--dim);font-size:14px;padding:2px 9px;font-family:var(--mono)}
.mnav:active{transform:scale(.85)}.mnav:disabled{opacity:.2;pointer-events:none}
.cal-title{font-family:var(--mono);font-size:9px;font-weight:700;color:var(--text);min-width:68px;text-align:center}
.dow-row{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-bottom:4px}
.dow{font-family:var(--mono);font-size:7px;font-weight:700;text-align:center;color:var(--dim);padding:2px 0}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.cday{border-radius:7px;aspect-ratio:1;width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;cursor:pointer;user-select:none}
.cday:not(.empty):active{transform:scale(.8)}.cday.empty{background:transparent!important;border:none!important;cursor:default;pointer-events:none}
.cnum{font-family:var(--mono);font-size:11px;font-weight:700;line-height:1}
.cval{font-family:var(--mono);font-size:6px;font-weight:700;text-align:center;white-space:nowrap}
.cal-sum{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-top:8px;padding-top:8px;border-top:1px solid var(--bord)}
.cs{text-align:center}.cs-lbl{font-size:7px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px}
.cs-val{font-family:var(--mono);font-size:10px;font-weight:700}.mwrap{height:120px}
.pg-ttl{font-size:16px;font-weight:800;margin-bottom:14px;color:var(--text)}
.scard{background:var(--surf);border:1px solid var(--bord);border-radius:var(--r);padding:2px 14px;margin-bottom:10px}
.srow{display:flex;align-items:center;justify-content:space-between;padding:13px 0;border-bottom:1px solid var(--bord);flex-wrap:wrap;gap:8px}
.srow:last-child{border-bottom:none}
.srow-col{padding:11px 0;border-bottom:1px solid var(--bord);display:flex;flex-direction:column;gap:7px}
.srow-col:last-child{border-bottom:none}
.slbl{font-size:13px;font-weight:600;color:var(--text);flex-shrink:0}.sval{font-family:var(--mono);font-size:11px;color:var(--dim)}
.slbl2{font-size:11px;color:var(--dim)}.inp-w{position:relative}
.sinp{width:100%;background:var(--surf2);border:1px solid var(--bord);border-radius:8px;padding:10px 40px 10px 12px;color:var(--text);font-family:var(--mono);font-size:12px}
.sinp:focus{border-color:var(--gd2)}.sinp::placeholder{color:var(--dim2)}
.eye{position:absolute;right:10px;top:50%;transform:translateY(-50%);font-size:15px;color:var(--dim);padding:4px;cursor:pointer}
.btn-save{width:100%;padding:12px;margin:10px 0 4px;background:var(--gd);border:1px solid var(--gd2);border-radius:9px;color:var(--green);font-size:12px;font-weight:700}
.btn-save:active{opacity:.7}.btn-save:disabled{opacity:.4}
.theme-tog{display:flex;background:var(--surf2);border-radius:8px;padding:2px;gap:2px}
.tt{padding:4px 10px;border-radius:6px;font-size:9px;font-weight:700;color:var(--dim);font-family:var(--mono);cursor:pointer}
.tt.on{background:var(--surf);color:var(--text);box-shadow:0 1px 4px rgba(0,0,0,.3)}
.cur-row{display:flex;gap:4px;flex-wrap:wrap}
.cur{padding:4px 10px;border-radius:6px;font-size:9px;font-weight:700;cursor:pointer;background:var(--surf2);border:1px solid var(--bord);color:var(--dim);font-family:var(--mono)}
.cur.on{background:var(--gd);border-color:var(--gd2);color:var(--green)}
.btn-danger{width:100%;padding:13px;background:var(--rd);border:1px solid rgba(255,61,90,.25);border-radius:var(--r);font-family:var(--mono);font-size:11px;font-weight:700;color:var(--red);margin-bottom:8px;cursor:pointer}
.btn-danger:active{opacity:.7}.ver{font-size:9px;color:var(--dim2);text-align:center;font-family:var(--mono);padding:4px 0 20px}
.dbg-wrap{background:var(--surf);border:1px solid rgba(0,230,118,.3);border-radius:var(--r);padding:12px;margin-bottom:10px}
.dbg-title{font-size:10px;font-weight:700;color:var(--green);margin-bottom:8px;font-family:var(--mono)}
.dbg-box{font-family:var(--mono);font-size:9px;color:#aaa;line-height:1.8;word-break:break-all;max-height:200px;overflow-y:auto;white-space:pre-wrap}
.dbg-box::-webkit-scrollbar{display:none}
.panel{position:absolute;inset:0;background:var(--bg);z-index:40;display:flex;flex-direction:column;transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1)}
.panel.open{transform:translateX(0)}
.panel-hdr{height:var(--hdr);display:flex;align-items:center;gap:10px;padding:0 14px;border-bottom:1px solid var(--bord);flex-shrink:0;background:var(--bg)}
.back{width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:var(--surf);border:1px solid var(--bord);border-radius:8px;font-size:14px;color:var(--text);cursor:pointer}
.panel-sym{font-size:16px;font-weight:800;color:var(--text)}
.pscroll{flex:1;overflow-y:auto;padding:12px;scrollbar-width:none}.pscroll::-webkit-scrollbar{display:none}
.trade-card{background:var(--surf);border:1px solid var(--bord);border-radius:var(--r);padding:14px;margin-bottom:10px}
.tc1{display:flex;align-items:center;justify-content:space-between;gap:6px;margin-bottom:7px}
.tc-l{display:flex;align-items:center;gap:8px}
.tcsym{font-size:15px;font-weight:800;color:var(--text)}
.tcpnl{font-family:var(--mono);font-size:17px;font-weight:700;flex-shrink:0}
.tcpnl.pos{color:var(--green)}.tcpnl.neg{color:var(--red)}.tcpnl.zero{color:var(--dim)}
.tc2{display:flex;justify-content:space-between}.tcm{font-size:10px;color:var(--dim);font-family:var(--mono)}
.iblock{background:var(--surf);border:1px solid var(--bord);border-radius:var(--r);padding:0 14px}
.irow{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--surf2)}
.irow:last-child{border-bottom:none}
.ilbl{font-size:11px;color:var(--dim)}.ival{font-family:var(--mono);font-size:11px;font-weight:700;color:var(--text)}
.ival.pos{color:var(--green)}.ival.neg{color:var(--red)}
.irow.total{padding:12px 0}.irow.total .ilbl{font-size:12px;font-weight:700;color:var(--text)}.irow.total .ival{font-size:14px}
.sheet{position:absolute;bottom:0;left:0;right:0;background:var(--surf);border:1px solid var(--bord);border-bottom:none;border-radius:16px 16px 0 0;transform:translateY(100%);transition:transform .3s cubic-bezier(.25,.8,.25,1);z-index:40;max-height:58%;display:flex;flex-direction:column}
.sheet.open{transform:translateY(0)}
.grip{width:34px;height:3px;background:var(--bord);border-radius:2px;margin:10px auto 6px}
.sheet-hdr{display:flex;justify-content:space-between;align-items:flex-start;padding:0 14px 10px;border-bottom:1px solid var(--bord);flex-shrink:0}
.sh-name{font-size:11px;color:var(--dim);margin-bottom:2px}.sh-total{font-family:var(--mono);font-size:18px;font-weight:700}
.sh-x{color:var(--dim);font-size:22px;padding:0 4px;line-height:1;cursor:pointer}
.sh-list{overflow-y:auto;padding:0 14px;flex:1;scrollbar-width:none;padding-bottom:env(safe-area-inset-bottom,12px)}
.sh-list::-webkit-scrollbar{display:none}
.sh-tr{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--bord)}.sh-tr:last-child{border-bottom:none}
.sh-l{display:flex;flex-direction:column;gap:4px}.sh-sym{font-size:13px;font-weight:800;color:var(--text)}
.sh-meta{display:flex;align-items:center;gap:5px}.sh-det{font-size:9px;color:var(--dim);font-family:var(--mono)}
.sh-pnl{font-family:var(--mono);font-size:13px;font-weight:700}
.overlay{position:absolute;inset:0;background:rgba(0,0,0,.58);opacity:0;pointer-events:none;transition:opacity .25s;z-index:35;backdrop-filter:blur(2px)}
.overlay.open{opacity:1;pointer-events:all}
.empty-st{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px 24px;gap:10px;text-align:center;flex:1}
.e-ic{font-size:44px;margin-bottom:4px}.e-ttl{font-size:15px;font-weight:700;color:var(--text)}.e-sub{font-size:11px;color:var(--dim);line-height:1.65}
.e-cta{margin-top:10px;padding:11px 24px;background:var(--gd);border:1px solid var(--gd2);border-radius:10px;color:var(--green);font-size:12px;font-weight:700;cursor:pointer}
.toast{position:fixed;bottom:76px;left:50%;transform:translateX(-50%) translateY(14px);background:var(--surf);border:1px solid var(--bord);color:var(--text);padding:10px 20px;border-radius:12px;font-size:11px;font-family:var(--mono);opacity:0;transition:all .28s;z-index:200;white-space:nowrap;pointer-events:none;box-shadow:0 4px 24px rgba(0,0,0,.5)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}.toast.ok{border-color:var(--gd2);color:var(--green)}.toast.err{border-color:rgba(255,61,90,.4);color:var(--red)}
</style>
</head>
<body>
<div id="app" data-theme="dark">
<div class="hdr"><div class="logo">Trade<em>Book</em></div><div class="hdr-r"><span class="slbl" id="slbl" onclick="manualSync()">tap to sync</span><div class="sdot" id="sdot"></div></div></div>
<div id="main">
<div id="pg-dashboard" class="page active">
  <div class="strip" id="pstrip"><div class="chip on" data-p="7d">7D</div><div class="chip" data-p="30d">30D</div><div class="chip" data-p="90d">90D</div><div class="chip" data-p="180d">180D</div><div class="chip" data-p="all">All Time</div></div>
  <div class="scroll"><div id="dash"></div></div>
</div>
<div id="pg-trades" class="page">
  <div class="strip" id="fstrip"><div class="chip on" data-f="all">All</div><div class="chip" data-f="futures">Futures</div><div class="chip" data-f="spot">Spot</div><div class="chip" data-f="win">Profit</div><div class="chip" data-f="loss">Loss</div></div>
  <div class="lscroll" id="tlist"></div>
</div>
<div id="pg-analysis" class="page">
  <div class="scroll" id="ascroll">
    <div class="card">
      <div class="cnav"><div class="cttl">Daily P&amp;L</div><div style="display:flex;align-items:center;gap:4px"><button class="mnav" id="pmo">&#8249;</button><span class="cal-title" id="cal-title">--</span><button class="mnav" id="nmo">&#8250;</button></div></div>
      <div class="dow-row"><div class="dow">Su</div><div class="dow">Mo</div><div class="dow">Tu</div><div class="dow">We</div><div class="dow">Th</div><div class="dow">Fr</div><div class="dow">Sa</div></div>
      <div class="cal-grid" id="cgrid"></div><div class="cal-sum" id="csum"></div>
    </div>
    <div class="card">
      <div class="cnav"><div class="cttl">Monthly P&amp;L</div><div style="display:flex;align-items:center;gap:4px"><button class="mnav" id="pyr">&#8249;</button><span class="cal-title" id="yr-lbl">--</span><button class="mnav" id="nyr">&#8250;</button></div></div>
      <div class="mwrap"><canvas id="mchart"></canvas></div>
    </div>
  </div>
</div>
<div id="pg-settings" class="page">
  <div class="scroll">
    <div class="pg-ttl">Settings</div>
    <div class="scard">
      <div class="srow" style="flex-direction:column;align-items:flex-start;gap:3px"><div class="slbl">Exchange</div><div class="sval">Bybit V5 REST API</div></div>
      <div class="srow-col"><div class="slbl2">API Key</div><div class="inp-w"><input id="ikey" type="text" class="sinp" placeholder="Paste your API Key" autocomplete="off" spellcheck="false"></div></div>
      <div class="srow-col"><div class="slbl2">API Secret</div><div class="inp-w"><input id="isec" type="password" class="sinp" placeholder="Paste your API Secret" autocomplete="off" spellcheck="false"><button class="eye" onclick="toggleSec()">&#128065;</button></div></div>
      <button class="btn-save" id="btn-test" onclick="testConn()">Test &amp; Save Connection</button>
    </div>
    <div class="scard">
      <div class="srow"><div class="slbl">Status</div><div class="sval" id="conn-st">Not connected</div></div>
      <div class="srow"><div class="slbl">Last Sync</div><div class="sval" id="ls-val">--</div></div>
      <div class="srow"><div class="slbl">Trades Loaded</div><div class="sval" id="tc-val">0</div></div>
      <div class="srow" style="border-bottom:none"><div class="slbl">Auto-sync</div><div class="sval" style="color:var(--green)">Every 5 min</div></div>
    </div>
    <div class="scard">
      <div class="srow"><div class="slbl">Theme</div><div class="theme-tog"><div class="tt on" id="tt-d" onclick="setTheme('dark')">&#127769; Dark</div><div class="tt" id="tt-l" onclick="setTheme('light')">&#9728; Light</div></div></div>
      <div class="srow" style="border-bottom:none"><div class="slbl">Currency</div><div class="cur-row" id="cur-row"><div class="cur on" data-c="USDT">USDT</div><div class="cur" data-c="USD">USD</div><div class="cur" data-c="EUR">EUR</div><div class="cur" data-c="GBP">GBP</div></div></div>
    </div>
    <div class="dbg-wrap"><div class="dbg-title">&#128269; Debug Log</div><div class="dbg-box" id="dbg">Tap sync to see log...</div></div>
    <button class="btn-danger" onclick="clearAll()">Disconnect &amp; Clear All Data</button>
    <div class="ver">TradeBook v7.0</div>
  </div>
</div>
<div id="tpanel" class="panel">
  <div class="panel-hdr"><button class="back" onclick="closePanel()">&#8592; Back</button><div class="panel-sym" id="psym"></div></div>
  <div class="pscroll" id="pbody"></div>
</div>
<div id="dsheet" class="sheet">
  <div class="grip"></div>
  <div class="sheet-hdr"><div><div class="sh-name" id="sh-name"></div><div class="sh-total" id="sh-total"></div></div><button class="sh-x" onclick="closeSheet()">&#215;</button></div>
  <div class="sh-list" id="sh-list"></div>
</div>
<div id="overlay" class="overlay" onclick="closeAll()"></div>
</div>
<nav class="nav">
  <button class="tab on" data-pg="dashboard"><span class="tic">&#128202;</span><span>Dashboard</span></button>
  <button class="tab" data-pg="trades"><span class="tic">&#128203;</span><span>Trades</span></button>
  <button class="tab" data-pg="analysis"><span class="tic">&#128200;</span><span>Analysis</span></button>
  <button class="tab" data-pg="settings"><span class="tic">&#9881;</span><span>Settings</span></button>
</nav>
</div>
<script>
'use strict';
const BAPI='https://api.bybit.com';
const MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const DOW=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const SYNC_I=5*60*1000;
const PD={'7d':7,'30d':30,'90d':90,'180d':180,'all':0};
const S={page:'dashboard',trades:[],bal:{total:0,avail:0},key:'',secret:'',cur:'USDT',fx:1,syncing:false,lastSync:null,period:'7d',filter:'all',calY:new Date().getFullYear(),calM:new Date().getMonth(),chartY:new Date().getFullYear(),theme:'dark',eqC:null,moC:null};
const LS={s:(k,v)=>{try{localStorage.setItem(k,typeof v==='string'?v:JSON.stringify(v))}catch(e){}},g:(k,d='')=>{try{const v=localStorage.getItem(k);return v!=null?v:d}catch(e){return d}},j:(k,d=null)=>{try{const v=localStorage.getItem(k);return v?JSON.parse(v):d}catch(e){return d}},d:(k)=>{try{localStorage.removeItem(k)}catch(e){}}};
function persist(){LS.s('k',S.key);LS.s('s',S.secret);LS.s('c',S.cur);LS.s('t',S.theme);LS.s('p',S.period);LS.s('tr',JSON.stringify(S.trades));LS.s('b',JSON.stringify(S.bal));if(S.lastSync)LS.s('ls',S.lastSync+'');}
function hydrate(){S.key=LS.g('k','');S.secret=LS.g('s','');S.cur=LS.g('c','USDT');S.theme=LS.g('t','dark');S.period=LS.g('p','7d');S.trades=LS.j('tr',[])||[];S.bal=LS.j('b',{total:0,avail:0})||{total:0,avail:0};const l=LS.g('ls','');S.lastSync=l?parseInt(l):null;}
let dbgLines=[];
function dbg(msg){dbgLines.push(msg);if(dbgLines.length>120)dbgLines.shift();const el=document.getElementById('dbg');if(el){el.textContent=dbgLines.join('\n');el.scrollTop=el.scrollHeight;}}
function fmt(u,c=false){const v=u*S.fx,a=Math.abs(v),sign=v>=0?'+':'-';let f;if(c&&a>=1e6)f=(a/1e6).toFixed(1)+'M';else if(c&&a>=1000)f=(a/1000).toFixed(1)+'K';else if(c&&a>=100)f=a.toFixed(0);else f=a.toFixed(2);return sign+f+' '+S.cur;}
function fmtN(n,dp=2){return parseFloat(n||0).toLocaleString('en-US',{minimumFractionDigits:dp,maximumFractionDigits:Math.max(dp,6)});}
function fmtT(ts){const d=new Date(ts);return String(d.getDate()).padStart(2,'0')+' '+MON[d.getMonth()]+' '+String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');}
function ago(ts){if(!ts)return'Never';const m=Math.floor((Date.now()-ts)/60000);if(m<1)return'Just now';if(m<60
